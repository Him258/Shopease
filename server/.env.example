PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OTP Configuration
# dev = OTP printed in server console (no SMS sent)
# sms = OTP sent via Fast2SMS (requires SMS_API_KEY)
OTP_MODE=dev
SMS_API_KEY=

# Admin Configuration (10-digit Indian mobile starting with 6-9)
ADMIN_MOBILE=
ADMIN_NAME=Admin

# Payment Gateways
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
